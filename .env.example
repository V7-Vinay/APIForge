APP_NAME=APIForge
APP_ENV=development
LOG_LEVEL=INFO
API_V1_PREFIX=/api/v1
CORS_ORIGINS=http://localhost:5173
POSTGRES_DB=apiforge
POSTGRES_USER=apiforge
POSTGRES_PASSWORD=apiforge_dev_password
DATABASE_URL=postgresql+asyncpg://apiforge:apiforge_dev_password@postgres:5432/apiforge
REDIS_URL=redis://redis:6379/0
JWT_SECRET_KEY=development-only-change-me
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30
REFRESH_COOKIE_NAME=apiforge_refresh_token
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
INVITATION_EXPIRE_DAYS=7

